# Copy to .env in the project folder (or beside the packaged executable).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Specify a model available to your provider. There is no automatic paid fallback.
OPENAI_MODEL=
# chat = OpenAI-compatible Chat Completions; responses = OpenAI Responses API
# Native modes: gemini or anthropic. Set the matching base URL and model.
# Gemini: https://generativelanguage.googleapis.com/v1beta
# Claude: https://api.anthropic.com/v1
# Native keys may also use GEMINI_API_KEY / GOOGLE_API_KEY / ANTHROPIC_API_KEY.
FORMA_API_MODE=chat
# auto, strict, json, or plain (for providers without JSON mode)
FORMA_RESPONSE_FORMAT=auto
FORMA_REVIEW_MODEL=
# Optional: none or low for supported reasoning models; empty uses provider defaults.
FORMA_REASONING_EFFORT=
FORMA_MAX_OUTPUT_TOKENS=0
FORMA_REQUEST_TIMEOUT=180
# Shared across the document queue, including PDF workers (1–16).
FORMA_MAX_PARALLEL_REQUESTS=8
# Simultaneous documents (1–4); use 1 for lower memory usage with large PDFs.
FORMA_PARALLEL_DOCUMENTS=2
# Local request pacing; 0 = no added pacing. Gemini Free Tier preset uses 5.
# Actual RPM/TPM/daily quotas and billing are controlled by your API project.
FORMA_REQUESTS_PER_MINUTE=0
# Optional absolute path to a separately installed BabelDOC executable.
FORMA_BABELDOC_PATH=
